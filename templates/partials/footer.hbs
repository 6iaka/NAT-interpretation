<footer>
    <div class="container">
        <div class="footer-top"><div><span class="eyebrow">A conversation starts here</span><h2>How can we help you connect?</h2></div><a class="text-link" href="contact.html">Get in touch <span aria-hidden="true">↗</span></a></div>
        <div class="footer-content">
            <div class="footer-brand"><h3>{{global.business_short}}</h3><p>{{global.footer.tagline}}</p></div>
            <div class="footer-section"><h3>Find us</h3><p>{{global.location}}</p><a href="tel:{{global.phone_link}}">{{global.phone_display}}</a><a href="mailto:{{global.email}}">{{global.email}}</a></div>
            <div class="footer-section"><h3>{{global.footer.quick_links_title}}</h3><ul class="footer-links">{{#each global.footer.quick_links}}<li><a href="{{href}}">{{label}}</a></li>{{/each}}</ul></div>
        </div>
        <div class="footer-bottom"><p>{{{global.footer.copyright}}}</p>{{#if global.footer.linkedin_url}}<a href="{{global.footer.linkedin_url}}" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in new tab)</span></a>{{/if}}</div>
    </div>
</footer>
