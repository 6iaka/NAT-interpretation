<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
</head>
<body>
    {{> header}}
    <main id="main-content">
        <section class="hero home-hero" aria-labelledby="home-heading">
            <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
                <source src="pexels-7147203-discussion.mp4?v=5" type="video/mp4">
            </video>
            <div class="hero-overlay"></div>
            <div class="container hero-content">
                <span class="eyebrow">Based in Maine. Connected to the world.</span>
                <h1 id="home-heading">{{hero.title}}</h1>
                <p class="hero-lead">{{hero.lead}}</p>
                <div class="hero-cta">
                    <a href="contact.html?service=quote" class="btn btn-primary">{{hero.cta_quote_label}} <span aria-hidden="true">↗</span></a>
                    <a href="tel:{{global.phone_link}}" class="hero-phone">{{global.phone_display}}<small>{{hero.cta_phone_label}}</small></a>
                </div>
            </div>
            <button class="video-toggle" type="button" aria-label="Pause background video">Pause video <span aria-hidden="true">Ⅱ</span></button>
        </section>

        <section class="section home-services" aria-labelledby="services-heading">
            <div class="container">
                <div class="section-heading split-heading">
                    <div><span class="eyebrow">What we do</span><h2 id="services-heading">{{services_preview.title}}</h2></div>
                    <p>{{services_preview.intro}}</p>
                </div>
                <div class="service-list">
                    {{#each services_preview.items}}
                    <article class="service-row">
                        <div class="service-row-photo"><img src="{{image}}" alt="{{image_alt}}" loading="lazy"></div>
                        <div class="service-row-title"><span class="index-number">0{{numberPrefix @index}}</span><h3>{{title}}</h3></div>
                        <div class="service-row-description"><p>{{description}}</p><a href="{{link_href}}" class="text-link">{{link_label}} <span aria-hidden="true">↗</span></a></div>
                    </article>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="section community-section" aria-labelledby="community-heading">
            <div class="container community-layout">
                <div class="community-intro"><span class="eyebrow">Who we serve</span><h2 id="community-heading">{{who_we_serve.title}}</h2><p>{{{who_we_serve.intro_1}}}</p><p>{{{who_we_serve.intro_2}}}</p></div>
                <div class="community-detail">
                    <h3>{{who_we_serve.audiences_title}}</h3>
                    <ul class="audience-list">{{#each who_we_serve.audiences_list}}<li>{{this}}</li>{{/each}}</ul>
                    <div class="community-note"><h3>{{who_we_serve.cultural_title}}</h3><p>{{who_we_serve.cultural_p1}}</p><a href="{{who_we_serve.cultural_cta_href}}" class="text-link">{{who_we_serve.cultural_cta_label}} <span aria-hidden="true">↗</span></a></div>
                </div>
            </div>
        </section>

        <section class="section how-it-works" aria-labelledby="process-heading">
            <div class="container">
                <div class="section-heading split-heading"><div><span class="eyebrow">Getting started</span><h2 id="process-heading">{{how_it_works.title}}</h2></div><p>{{how_it_works.intro}}</p></div>
                <div class="grid grid-3 process-grid">
                    {{#each how_it_works.steps}}
                    <article class="step"><span class="step-number">0{{number}}</span><h3>{{title}}</h3><p>{{description}}</p></article>
                    {{/each}}
                </div>
            </div>
        </section>

        {{#if partners.items.length}}
        <section class="section trusted-partners" aria-labelledby="partners-heading">
            <div class="container">
                <div class="section-heading"><span class="eyebrow">Working together</span><h2 id="partners-heading">{{partners.title}}</h2><p>{{partners.intro}}</p></div>
                <div class="partner-list">
                    {{#each partners.items}}
                    <a class="partner" href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{name}} (opens in new tab)"><div class="partner-logo-wrap"><img src="{{logo}}" alt="" loading="lazy"></div><span>{{name}}</span></a>
                    {{/each}}
                </div>
            </div>
        </section>
        {{/if}}

        <section class="section service-areas" aria-labelledby="areas-heading">
            <div class="container">
                <div class="section-heading split-heading"><div><span class="eyebrow">Here, and wherever you are</span><h2 id="areas-heading">{{service_areas.title}}</h2></div><p>{{service_areas.intro}}</p></div>
                <div class="grid grid-2 areas-grid">
                    {{#each service_areas.items}}
                    <article class="area"><span class="eyebrow">{{#if @first}}In person{{else}}By phone &amp; video{{/if}}</span><h3>{{title}}</h3><p>{{description}}</p></article>
                    {{/each}}
                </div>
                <a class="text-link" href="contact.html">Let’s talk about what you need <span aria-hidden="true">↗</span></a>
            </div>
        </section>
    </main>
    {{> footer}}
    {{> scripts}}
</body>
</html>
